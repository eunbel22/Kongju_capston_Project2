# .env

# ===================================================
# 로컬 개발 환경 설정
# ===================================================

# AI 모델 테스트 여부 (로컬에서만 적용)
# true: Kanana Safeguard 8B 사용 (느림, CPU)
# false: JSON 비속어 리스트 사용 (빠름)
USE_AI_SAFEGUARD=false

# ===================================================
# Milvus 설정 (발표용)
# ===================================================
# 평소 개발: false (FAISS 사용)
# 발표 당일: true (Milvus 사용)
USE_MILVUS=true
MILVUS_HOST=10.37.21.49

# ===================================================
# ⚠️ 주의사항
# ===================================================
# 서버 배포 시에는 이 파일 무시됨!
# GPU(RTX 3090) 자동 감지로 AI 모델 활성화
# 
# 📌 발표 당일 체크리스트:
# 1. 팀원과 같은 WiFi 연결
# 2. USE_MILVUS=true 로 변경
# 3. 서버 재시작
# ===================================================